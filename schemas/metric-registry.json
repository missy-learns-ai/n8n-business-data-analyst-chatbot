{
  "version": "1.1",
  "source_of_truth": "Supabase metric_registry table",
  "metrics": [
    {
      "metric_key": "order_count",
      "dataset_name": "ecommerce_orders",
      "display_name": "Order Count",
      "formula": "COUNT(*)",
      "business_definition": "Total number of ecommerce orders.",
      "format": "integer",
      "sort_default": "desc"
    },
    {
      "metric_key": "gross_sales",
      "dataset_name": "ecommerce_orders",
      "display_name": "Gross Sales",
      "formula": "SUM(quantity * unit_price)",
      "business_definition": "Total sales before discounts are removed.",
      "format": "currency",
      "sort_default": "desc"
    },
    {
      "metric_key": "net_sales",
      "dataset_name": "ecommerce_orders",
      "display_name": "Net Sales",
      "formula": "SUM((quantity * unit_price) - ((quantity * unit_price) * discount_percent / 100))",
      "business_definition": "Sales after discounts are removed.",
      "format": "currency",
      "sort_default": "desc"
    },
    {
      "metric_key": "return_rate",
      "dataset_name": "ecommerce_orders",
      "display_name": "Return Rate",
      "formula": "COUNT(*) FILTER (WHERE order_status = 'Returned')::numeric / NULLIF(COUNT(*), 0)",
      "business_definition": "Share of orders with Returned status.",
      "format": "ratio",
      "sort_default": "desc"
    },
    {
      "metric_key": "average_rating",
      "dataset_name": "ecommerce_orders",
      "display_name": "Average Rating",
      "formula": "AVG(rating)",
      "business_definition": "Average customer rating across ecommerce orders.",
      "format": "decimal",
      "sort_default": "desc"
    },
    {
      "metric_key": "average_delivery_days",
      "dataset_name": "ecommerce_orders",
      "display_name": "Average Delivery Days",
      "formula": "AVG(delivery_days)",
      "business_definition": "Average number of days between order and delivery.",
      "format": "decimal",
      "sort_default": "asc"
    },
    {
      "metric_key": "spend",
      "dataset_name": "marketing_campaigns",
      "display_name": "Spend",
      "formula": "SUM(spend)",
      "business_definition": "Total marketing campaign spend.",
      "format": "currency",
      "sort_default": "desc"
    },
    {
      "metric_key": "impressions",
      "dataset_name": "marketing_campaigns",
      "display_name": "Impressions",
      "formula": "SUM(impressions)",
      "business_definition": "Total number of ad impressions.",
      "format": "integer",
      "sort_default": "desc"
    },
    {
      "metric_key": "clicks",
      "dataset_name": "marketing_campaigns",
      "display_name": "Clicks",
      "formula": "SUM(clicks)",
      "business_definition": "Total number of ad clicks.",
      "format": "integer",
      "sort_default": "desc"
    },
    {
      "metric_key": "conversions",
      "dataset_name": "marketing_campaigns",
      "display_name": "Conversions",
      "formula": "SUM(conversions)",
      "business_definition": "Total number of campaign conversions.",
      "format": "integer",
      "sort_default": "desc"
    },
    {
      "metric_key": "revenue",
      "dataset_name": "marketing_campaigns",
      "display_name": "Revenue",
      "formula": "SUM(revenue)",
      "business_definition": "Total revenue attributed to marketing campaigns.",
      "format": "currency",
      "sort_default": "desc"
    },
    {
      "metric_key": "leads",
      "dataset_name": "marketing_campaigns",
      "display_name": "Leads",
      "formula": "SUM(leads)",
      "business_definition": "Total number of leads generated by marketing campaigns.",
      "format": "integer",
      "sort_default": "desc"
    },
    {
      "metric_key": "new_customers",
      "dataset_name": "marketing_campaigns",
      "display_name": "New Customers",
      "formula": "SUM(new_customers)",
      "business_definition": "Total number of new customers acquired through marketing campaigns.",
      "format": "integer",
      "sort_default": "desc"
    },
    {
      "metric_key": "ctr",
      "dataset_name": "marketing_campaigns",
      "display_name": "Click Through Rate",
      "formula": "SUM(clicks)::numeric / NULLIF(SUM(impressions), 0)",
      "business_definition": "Share of impressions that became clicks.",
      "format": "ratio",
      "sort_default": "desc"
    },
    {
      "metric_key": "conversion_rate",
      "dataset_name": "marketing_campaigns",
      "display_name": "Conversion Rate",
      "formula": "SUM(conversions)::numeric / NULLIF(SUM(clicks), 0)",
      "business_definition": "Share of clicks that became conversions.",
      "format": "ratio",
      "sort_default": "desc"
    },
    {
      "metric_key": "cost_per_click",
      "dataset_name": "marketing_campaigns",
      "display_name": "Cost Per Click",
      "formula": "SUM(spend)::numeric / NULLIF(SUM(clicks), 0)",
      "business_definition": "Average marketing spend per click.",
      "format": "currency",
      "sort_default": "asc"
    },
    {
      "metric_key": "cost_per_conversion",
      "dataset_name": "marketing_campaigns",
      "display_name": "Cost Per Conversion",
      "formula": "SUM(spend)::numeric / NULLIF(SUM(conversions), 0)",
      "business_definition": "Average marketing spend per conversion.",
      "format": "currency",
      "sort_default": "asc"
    },
    {
      "metric_key": "roas",
      "dataset_name": "marketing_campaigns",
      "display_name": "ROAS",
      "formula": "SUM(revenue)::numeric / NULLIF(SUM(spend), 0)",
      "business_definition": "Revenue generated per dollar of ad spend.",
      "format": "decimal",
      "sort_default": "desc"
    },
    {
      "metric_key": "revenue_per_click",
      "dataset_name": "marketing_campaigns",
      "display_name": "Revenue Per Click",
      "formula": "SUM(revenue)::numeric / NULLIF(SUM(clicks), 0)",
      "business_definition": "Average revenue generated per click.",
      "format": "currency",
      "sort_default": "desc"
    },
    {
      "metric_key": "lead_to_customer_rate",
      "dataset_name": "marketing_campaigns",
      "display_name": "Lead To Customer Rate",
      "formula": "SUM(new_customers)::numeric / NULLIF(SUM(leads), 0)",
      "business_definition": "Share of leads that became new customers.",
      "format": "ratio",
      "sort_default": "desc"
    }
  ]
}
