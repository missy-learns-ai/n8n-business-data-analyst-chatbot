{
  "version": "1.0",
  "metrics": [
    {
      "id": "order_count",
      "name": "Order Count",
      "dataset": "ecommerce_orders",
      "description": "Total number of orders in the selected data.",
      "formula": "count(Order_ID)",
      "required_fields": ["Order_ID"],
      "default_aggregation": "count",
      "format": "integer"
    },
    {
      "id": "gross_sales",
      "name": "Gross Sales",
      "dataset": "ecommerce_orders",
      "description": "Sales before discounts and shipping costs.",
      "formula": "sum(Quantity * Unit_Price)",
      "required_fields": ["Quantity", "Unit_Price"],
      "default_aggregation": "sum",
      "format": "currency"
    },
    {
      "id": "discount_amount",
      "name": "Discount Amount",
      "dataset": "ecommerce_orders",
      "description": "Total discount amount applied to orders.",
      "formula": "sum((Quantity * Unit_Price) * (Discount_Percent / 100))",
      "required_fields": ["Quantity", "Unit_Price", "Discount_Percent"],
      "default_aggregation": "sum",
      "format": "currency"
    },
    {
      "id": "net_sales",
      "name": "Net Sales",
      "dataset": "ecommerce_orders",
      "description": "Sales after discounts, before shipping costs.",
      "formula": "sum((Quantity * Unit_Price) - ((Quantity * Unit_Price) * (Discount_Percent / 100)))",
      "required_fields": ["Quantity", "Unit_Price", "Discount_Percent"],
      "default_aggregation": "sum",
      "format": "currency"
    },
    {
      "id": "estimated_profit",
      "name": "Estimated Profit",
      "dataset": "ecommerce_orders",
      "description": "Estimated profit after applying a 35% margin to net sales and subtracting shipping cost.",
      "formula": "sum(((Quantity * Unit_Price) - ((Quantity * Unit_Price) * (Discount_Percent / 100))) * 0.35 - Shipping_Cost)",
      "required_fields": ["Quantity", "Unit_Price", "Discount_Percent", "Shipping_Cost"],
      "default_aggregation": "sum",
      "format": "currency"
    },
    {
      "id": "return_rate",
      "name": "Return Rate",
      "dataset": "ecommerce_orders",
      "description": "Share of orders with Order_Status equal to Returned.",
      "formula": "count(Order_Status = 'Returned') / count(Order_ID)",
      "required_fields": ["Order_Status", "Order_ID"],
      "default_aggregation": "ratio",
      "format": "percentage"
    },
    {
      "id": "average_rating",
      "name": "Average Rating",
      "dataset": "ecommerce_orders",
      "description": "Average customer rating for selected orders.",
      "formula": "avg(Rating)",
      "required_fields": ["Rating"],
      "default_aggregation": "average",
      "format": "decimal"
    },
    {
      "id": "average_delivery_days",
      "name": "Average Delivery Days",
      "dataset": "ecommerce_orders",
      "description": "Average number of delivery days for selected orders.",
      "formula": "avg(Delivery_Days)",
      "required_fields": ["Delivery_Days"],
      "default_aggregation": "average",
      "format": "decimal"
    },
    {
      "id": "campaign_count",
      "name": "Campaign Count",
      "dataset": "marketing_campaigns",
      "description": "Total number of campaigns in the selected data.",
      "formula": "count(Campaign_ID)",
      "required_fields": ["Campaign_ID"],
      "default_aggregation": "count",
      "format": "integer"
    },
    {
      "id": "spend",
      "name": "Spend",
      "dataset": "marketing_campaigns",
      "description": "Total marketing spend.",
      "formula": "sum(Spend)",
      "required_fields": ["Spend"],
      "default_aggregation": "sum",
      "format": "currency"
    },
    {
      "id": "impressions",
      "name": "Impressions",
      "dataset": "marketing_campaigns",
      "description": "Total ad impressions.",
      "formula": "sum(Impressions)",
      "required_fields": ["Impressions"],
      "default_aggregation": "sum",
      "format": "integer"
    },
    {
      "id": "clicks",
      "name": "Clicks",
      "dataset": "marketing_campaigns",
      "description": "Total ad clicks.",
      "formula": "sum(Clicks)",
      "required_fields": ["Clicks"],
      "default_aggregation": "sum",
      "format": "integer"
    },
    {
      "id": "conversions",
      "name": "Conversions",
      "dataset": "marketing_campaigns",
      "description": "Total conversions generated by campaigns.",
      "formula": "sum(Conversions)",
      "required_fields": ["Conversions"],
      "default_aggregation": "sum",
      "format": "integer"
    },
    {
      "id": "revenue",
      "name": "Revenue",
      "dataset": "marketing_campaigns",
      "description": "Total campaign-attributed revenue.",
      "formula": "sum(Revenue)",
      "required_fields": ["Revenue"],
      "default_aggregation": "sum",
      "format": "currency"
    },
    {
      "id": "leads",
      "name": "Leads",
      "dataset": "marketing_campaigns",
      "description": "Total leads generated by campaigns.",
      "formula": "sum(Leads)",
      "required_fields": ["Leads"],
      "default_aggregation": "sum",
      "format": "integer"
    },
    {
      "id": "new_customers",
      "name": "New Customers",
      "dataset": "marketing_campaigns",
      "description": "Total new customers acquired from campaigns.",
      "formula": "sum(New_Customers)",
      "required_fields": ["New_Customers"],
      "default_aggregation": "sum",
      "format": "integer"
    },
    {
      "id": "ctr",
      "name": "Click-Through Rate",
      "dataset": "marketing_campaigns",
      "description": "Share of impressions that resulted in clicks.",
      "formula": "sum(Clicks) / sum(Impressions)",
      "required_fields": ["Clicks", "Impressions"],
      "default_aggregation": "ratio",
      "format": "percentage"
    },
    {
      "id": "conversion_rate",
      "name": "Conversion Rate",
      "dataset": "marketing_campaigns",
      "description": "Share of clicks that resulted in conversions.",
      "formula": "sum(Conversions) / sum(Clicks)",
      "required_fields": ["Conversions", "Clicks"],
      "default_aggregation": "ratio",
      "format": "percentage"
    },
    {
      "id": "cost_per_click",
      "name": "Cost per Click",
      "dataset": "marketing_campaigns",
      "description": "Average spend for each click.",
      "formula": "sum(Spend) / sum(Clicks)",
      "required_fields": ["Spend", "Clicks"],
      "default_aggregation": "ratio",
      "format": "currency"
    },
    {
      "id": "cost_per_conversion",
      "name": "Cost per Conversion",
      "dataset": "marketing_campaigns",
      "description": "Average spend for each conversion.",
      "formula": "sum(Spend) / sum(Conversions)",
      "required_fields": ["Spend", "Conversions"],
      "default_aggregation": "ratio",
      "format": "currency"
    },
    {
      "id": "roas",
      "name": "Return on Ad Spend",
      "dataset": "marketing_campaigns",
      "description": "Revenue generated for each dollar spent on marketing.",
      "formula": "sum(Revenue) / sum(Spend)",
      "required_fields": ["Revenue", "Spend"],
      "default_aggregation": "ratio",
      "format": "decimal"
    },
    {
      "id": "revenue_per_click",
      "name": "Revenue per Click",
      "dataset": "marketing_campaigns",
      "description": "Average revenue generated per click.",
      "formula": "sum(Revenue) / sum(Clicks)",
      "required_fields": ["Revenue", "Clicks"],
      "default_aggregation": "ratio",
      "format": "currency"
    },
    {
      "id": "lead_to_customer_rate",
      "name": "Lead-to-Customer Rate",
      "dataset": "marketing_campaigns",
      "description": "Share of leads that became new customers.",
      "formula": "sum(New_Customers) / sum(Leads)",
      "required_fields": ["New_Customers", "Leads"],
      "default_aggregation": "ratio",
      "format": "percentage"
    },
    {
      "id": "average_bounce_rate",
      "name": "Average Bounce Rate",
      "dataset": "marketing_campaigns",
      "description": "Average campaign bounce rate.",
      "formula": "avg(Bounce_Rate)",
      "required_fields": ["Bounce_Rate"],
      "default_aggregation": "average",
      "format": "percentage"
    },
    {
      "id": "average_session_duration",
      "name": "Average Session Duration",
      "dataset": "marketing_campaigns",
      "description": "Average session duration in seconds.",
      "formula": "avg(Avg_Session_Duration_Sec)",
      "required_fields": ["Avg_Session_Duration_Sec"],
      "default_aggregation": "average",
      "format": "seconds"
    }
  ]
}
